@startuml
'https://plantuml.com/sequence-diagram


class Main
class Movie
class TextUI
class User
class FileIO

Main..>TextUI
Main..>FileIO
FileIO..>Movie: creates
User-->Movie: has 0 or many
TextUI-->Movie
TextUI-->User

class Main{
+main(args: String []): void
}

class User {
  -username : String
  -password : String
  -saveMovie: ArrayList<Movie>
  -seenMovies : ArrayList<Movie>

  +User(username: String, password: String)
  +getUsername (): String
  +checkPassword(password: String): boolean
  +saveMovie(movie: Movie): void
  +addSeenMovie (movie : Movie): void
  +getSavedMovies ():ArrayList<Movie>
  +getSeenMovies (): ArrayList<Movie>

  }
class Movie {
  -title : String
  -year : int
  -categories: String
  -rating : double

  +Movie(title: String, year: int, categories:String, rating: double)
  +getTitle (): String
  +getYear(): int
  +getCategory(): String
  +getRating(): double
  +toString() : String
  }
class TextUI {
- movies: ArrayList<Movie> movies
- favorites: ArrayList<Movie> favorites
- scan: Scanner scan
-user: User

+ TextUI(movies: ArrayList<Movie>, scan: Scanner)
+start(): void
-registerUser(): void
-loginUser(): boolean
-showMainMenu(): void
+showMovies(): void
-searchMovie(): void
-selectedMovie(movie : Movie): void
+startMovie(movie : Movie): void
+saveMovie (movie : Movie): void
-showSavedMovies(): void
-showSeenMovies(): void
+addToFavorites(movie : Movie): void
-showFavorites(): void

}
class FileIO {
  {static} +readMovies(path) : ArrayList<Movie>
  {static} +readUsers(path, movies) : ArrayList<User>
  {static} +saveUsers(path, users)

  +readMoviesFromFile(fileName: String): ArrayList<Movie>
}




@enduml