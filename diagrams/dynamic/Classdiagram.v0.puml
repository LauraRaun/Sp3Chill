@startuml
'https://plantuml.com/class-diagram

class Main
Main-->StreamingServices
class TextUI
class StreamingServices
abstract class Media
StreamingServices--|>TextUI
StreamingServices--|>FileIO
class  FileIO
StreamingServices--|>Media
class User
class Film
StreamingServices--|>User
Media<--Film: is a
User-->Media:has a

class StreamingServices {
-movies : ArrayList<Movie>
  -users : ArrayList<User>
  -currentUser : User
  +start()
  +createUser()
  +login() : boolean
  +searchByTitle()
  +searchByCategory()
  +chooseFromList(list, emptyMessage)
  +play(movie)
}
class FileIO {
  {static} +readMovies(path) : ArrayList<Movie>
  {static} +readUsers(path, movies) : ArrayList<User>
  {static} +saveUsers(path, users)
}
class Film {
  -title : String
  -year : int
  -categories : ArrayList<String>
  -rating : double
  +toString() : String
}
class User {
  -username : String
  -password : String
  -seenMovies : ArrayList<Movie>
  -savedMovies : ArrayList<Movie>
  +addSeen(movie)
  +saveMovie(movie)
  +removeSaved(movie)
}
class TextUI {
-ArrayList<Movie> movies
- ArrayList<Movie> favorites
- Scanner scan
}

@enduml